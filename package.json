{
  "name": "chat-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time one-to-one chat app with username search and friend requests (MERN + Socket.IO)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspace client",
    "start": "cross-env NODE_ENV=production node server/src/server.js",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
