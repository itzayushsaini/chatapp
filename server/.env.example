# Copy this file to server/.env and fill in the values.
# server/.env is listed in .gitignore and must never be committed.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/chatapp

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional error tracking. Leave blank if you are not using Sentry.
SENTRY_DSN=

# Password-reset emails, sent via Brevo (https://app.brevo.com - free tier).
# Get BREVO_API_KEY from Brevo -> Settings -> SMTP & API -> API Keys.
# EMAIL_FROM_ADDRESS must be a sender verified in Brevo -> Senders & IP.
# Left blank, "forgot password" still works but silently does not email
# anyone (a warning is logged) - fine for local development.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PingMe

# The web address people use to reach this app. Used to build the link
# inside password-reset emails. Vite's address in development; set this
# to your deployed URL in production (e.g. https://pingme.onrender.com).
APP_URL=http://localhost:5173

# Optional "Continue with Google". Create an OAuth client (type "Web
# application") in Google Cloud Console -> APIs & Services -> Credentials,
# with this authorized redirect URI (APP_URL + the path):
#   http://localhost:5173/api/auth/google/callback
# Left blank, the Google button is simply not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
