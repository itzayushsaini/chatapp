# Copy this file to server/.env and fill in the values.
# server/.env is listed in .gitignore and must never be committed.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/chatapp

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional error tracking. Leave blank if you are not using Sentry.
SENTRY_DSN=
