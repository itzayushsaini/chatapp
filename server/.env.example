# Copy to server/.env (never commit it)

PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/chatapp

# at least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

SENTRY_DSN=

# Brevo, for password-reset emails (optional)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PingMe

# used in reset links and as the Google redirect base
APP_URL=http://localhost:5173

# optional; redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# optional, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# optional; generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
